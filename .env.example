# Dialogos v3. Never expose server-side secrets to the browser.
OPENAI_API_KEY=sk-proj_REPLACE_ME
# Model/settings are pinned in code: gpt-5.4-mini, low, standard, 6000/900 tokens.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Start with Stripe test mode; use a separate Supabase project for testing.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Production: the verified canonical HTTPS origin, with no path/query/fragment.
# Also used at BUILD TIME for public canonical / OG / X card URLs. Redeploy after changes.
# Never set this to a secret, a dashboard URL or a temporary preview/bypass URL.
APP_URL=http://127.0.0.1:5177
PORT=5177

# Keep false until migrations 003 + 004 + 005 + 006 and abuse controls are verified.
# 3 replies total per guest browser / Google account per Asia/Tokyo day, any sage.
TRIAL_ENABLED=false
# Anonymous trial is separately fail-closed until these settings are ready.
ANONYMOUS_TRIAL_ENABLED=false
# Generate a cryptographically random server-only secret (at least 32 bytes).
# Never reuse an API key. Rotation invalidates existing anonymous sessions.
GUEST_SESSION_SECRET=
# Public site key + server-only secret from the same Turnstile widget.
# Restrict its hostnames to APP_URL. Never use Cloudflare testing keys in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Existing paid chat requires verified billing configuration; preserve existing contracts.
BILLING_ENABLED=false
# New sales are stopped for the free persona-takeaway strategy. Keep false.
SALES_ENABLED=false
# Calendar day/month in UTC. Reservations count toward these limits.
API_DAILY_BUDGET_USD=3
API_MONTHLY_BUDGET_USD=30
# Trial-only sublimits, INSIDE the total budgets above (not additional spending).
# Initial safety values: about 37 full 3-reply trials/day, 370/month at $0.0045/reply.
API_TRIAL_DAILY_BUDGET_USD=0.50
API_TRIAL_MONTHLY_BUDGET_USD=5
